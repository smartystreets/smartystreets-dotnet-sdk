<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SmartyStreets</RootNamespace>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!--
      net8.0+ targets resolve the SDK's net8.0+ builds, so only an older target covers the
      netstandard2.0 build (including NativeSender's NETSTANDARD2_0 branch). net472 needs
      .NET Framework (Windows) or Mono, so it is added on Windows only; elsewhere `make test`
      is unaffected. `make test-netstandard` runs net6.0 in Docker instead (NetStandardCheck).
    -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net472;net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(NetStandardCheck)' == 'true'">net6.0</TargetFrameworks>
    <CheckEolTargetFramework Condition="'$(NetStandardCheck)' == 'true'">false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\sdk\sdk.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- .NET Framework does not include System.Net.Http in the default assembly set. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="15.7.0" />
    <PackageReference Include="NUnit" Version="3.10.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.10.0" />
  </ItemGroup>
</Project>
